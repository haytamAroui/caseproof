  "failure_precedence": [
    "authentication_required:401",
    "cross_tenant_masked:404",
    "permission_denied:403",
    "idempotency_conflict:409",
    "stale_revision:409",
    "invalid_transition:409",
    "gate_blocked:409",
    "audit_unavailable:409",
    "malformed_or_forbidden_input:422"
  ],
  "security_assertions": [
    "tenant_id actor_id role authorized approval_authority are never client-controlled request fields",
