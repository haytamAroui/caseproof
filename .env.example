# Optional: enables AI tutor, roleplay replies, sentence improvement, and text correction.
# Keep this key server-side; never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Optional model override. Defaults to gpt-5.4-mini.
OPENAI_MODEL=gpt-5.4-mini

# Supabase project (Postgres + auth). Without these the app stores progress in this browser only.
# Supabase Management API token, used only for project setup. Revoke it when finished.
SUPABASE_ACCESS_TOKEN=


# Project URL — from Settings > API Keys, top of the page
NEXT_PUBLIC_SUPABASE_URL=https://ldwmocpxwskvhoojndrd.supabase.co

# Public publishable key — safe for browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend dev alias — same publishable key
CASEPROOF_DEV_PUBLISHABLE_KEY=

# Allow sign-in from the Vite dev server
CASEPROOF_DEV_ALLOWED_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5175,http://localhost:5175

# From "Secret keys" section — click "Reveal API key" to see it
SUPABASE_SERVICE_ROLE_KEY=
