{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "release_authorized": {
      "const": false,
      "title": "Release Authorized",
      "type": "boolean"
    },
    "replayed": {
      "title": "Replayed",
      "type": "boolean"
    },
    "revision": {
      "maximum": 100000,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "schema": {
      "const": "caseproof-clearbrief-review-receipt-v1",
      "title": "Schema",
      "type": "string"
    },
    "snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Hash",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "snapshot_hash",
    "revision",
    "replayed",
    "release_authorized"
  ],
  "title": "ClearbriefReviewReceipt",
  "type": "object"
}
