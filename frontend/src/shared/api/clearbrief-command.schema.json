{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "disposition": {
      "enum": [
        "confirmed_candidate",
        "dismissed",
        "needs_information"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "expected_revision": {
      "maximum": 256,
      "minimum": 0,
      "title": "Expected Revision",
      "type": "integer"
    },
    "observation_id": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "rationale": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    },
    "snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Hash",
      "type": "string"
    }
  },
  "required": [
    "snapshot_hash",
    "observation_id",
    "request_id",
    "expected_revision",
    "disposition",
    "rationale"
  ],
  "title": "ReviewBody",
  "type": "object"
}
