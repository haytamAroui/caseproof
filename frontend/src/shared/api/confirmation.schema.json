{
  "$defs": {
    "IdentityConfirmation": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "stuk",
            "piece"
          ],
          "title": "Label",
          "type": "string"
        },
        "number": {
          "pattern": "^\\d{1,4}(?:bis|ter)?$",
          "title": "Number",
          "type": "string"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/PageConfirmation"
          },
          "maxItems": 128,
          "title": "Pages",
          "type": "array"
        },
        "source_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Version Id"
        }
      },
      "required": [
        "label",
        "number"
      ],
      "title": "IdentityConfirmation",
      "type": "object"
    },
    "InventoryReviewException": {
      "additionalProperties": false,
      "description": "Versioned, source-anchored human observation, not a verified identity.",
      "properties": {
        "citation": {
          "maxLength": 200,
          "minLength": 3,
          "title": "Citation",
          "type": "string"
        },
        "kind": {
          "enum": [
            "detector_miss",
            "unsupported_notation"
          ],
          "title": "Kind",
          "type": "string"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 5,
          "title": "Rationale",
          "type": "string"
        },
        "review_state": {
          "const": "review_needed",
          "default": "review_needed",
          "title": "Review State",
          "type": "string"
        },
        "version": {
          "const": 1,
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "citation",
        "rationale"
      ],
      "title": "InventoryReviewException",
      "type": "object"
    },
    "PageConfirmation": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 12,
          "minLength": 1,
          "pattern": "^(?:[0-9]{1,6}|m{0,3}(?:cm|cd|d?c{0,3})(?:xc|xl|l?x{0,3})(?:ix|iv|v?i{0,3})|M{0,3}(?:CM|CD|D?C{0,3})(?:XC|XL|L?X{0,3})(?:IX|IV|V?I{0,3}))$",
          "title": "Label",
          "type": "string"
        },
        "pdf_page": {
          "maximum": 64,
          "minimum": 1,
          "title": "Pdf Page",
          "type": "integer"
        },
        "rationale": {
          "maxLength": 500,
          "minLength": 3,
          "title": "Rationale",
          "type": "string"
        },
        "space": {
          "enum": [
            "printed",
            "bundle"
          ],
          "title": "Space",
          "type": "string"
        }
      },
      "required": [
        "space",
        "label",
        "pdf_page",
        "rationale"
      ],
      "title": "PageConfirmation",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_signature": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Signature",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/IdentityConfirmation"
      },
      "maxItems": 512,
      "title": "Entries",
      "type": "array"
    },
    "exceptions": {
      "items": {
        "$ref": "#/$defs/InventoryReviewException"
      },
      "maxItems": 64,
      "title": "Exceptions",
      "type": "array"
    },
    "inventory_complete": {
      "title": "Inventory Complete",
      "type": "boolean"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "bundle_signature",
    "request_id",
    "inventory_complete",
    "entries"
  ],
  "title": "InventoryConfirmation",
  "type": "object"
}
