{
  "$defs": {
    "OtherFindingView": {
      "additionalProperties": false,
      "description": "Another finding inside the same excerpt, separately checked.",
      "properties": {
        "quote_span": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Span"
        },
        "reference_id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "span": {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Span",
          "type": "array"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNVERIFIED",
            "UNDETERMINED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "status",
        "span"
      ],
      "title": "OtherFindingView",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The lawyer's sentence beside the exact stored article text.",
  "properties": {
    "article_text": {
      "anyOf": [
        {
          "maxLength": 200000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Article Text"
    },
    "brief_excerpt": {
      "maxLength": 2000,
      "title": "Brief Excerpt",
      "type": "string"
    },
    "citation_span": {
      "items": {
        "type": "integer"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Citation Span",
      "type": "array"
    },
    "corpus_key": {
      "anyOf": [
        {
          "maxLength": 400,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Key"
    },
    "corpus_source_uri": {
      "anyOf": [
        {
          "maxLength": 1000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Source Uri"
    },
    "corpus_text_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Text Sha256"
    },
    "corpus_version": {
      "anyOf": [
        {
          "maxLength": 400,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corpus Version"
    },
    "note": {
      "maxLength": 1000,
      "title": "Note",
      "type": "string"
    },
    "observation_id": {
      "maxLength": 220,
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "other_findings": {
      "items": {
        "$ref": "#/$defs/OtherFindingView"
      },
      "maxItems": 200,
      "title": "Other Findings",
      "type": "array"
    },
    "quote": {
      "anyOf": [
        {
          "maxLength": 4000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quote"
    },
    "quote_span": {
      "anyOf": [
        {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quote Span"
    },
    "reason": {
      "maxLength": 400,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "schema": {
      "const": "caseproof-legal-passage-v1",
      "title": "Schema",
      "type": "string"
    },
    "snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Snapshot Hash",
      "type": "string"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNVERIFIED",
        "UNDETERMINED"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "observation_id",
    "snapshot_hash",
    "brief_excerpt",
    "citation_span",
    "quote",
    "quote_span",
    "other_findings",
    "status",
    "reason",
    "note"
  ],
  "title": "LegalPassageView",
  "type": "object"
}
